# Copy to .env and change values as needed.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Application authentication (required for public-facing deployment).
# Generate a PBKDF2-SHA256 hash with scripts/generate_auth_hash.py and store
# the resulting value as AUTH_PASSWORD_HASH in the deployment secret store.
AUTH_USERNAME=analyst
AUTH_PASSWORD_HASH=<SET_IN_DEPLOYMENT_SECRET_STORE>
AUTH_ROLE=analyst
AUTH_SESSION_TTL_SECONDS=3600
AUTH_PBKDF2_ITERATIONS=600000

# Local Ollama via its OpenAI-compatible API.
LLM_PROVIDER=ollama
LLM_MODEL=llama2
OLLAMA_MODEL=llama2
OLLAMA_API_BASE=http://localhost:11434/v1
API_BASE_URL=http://localhost:11434/v1
# Ollama does not require a real API key locally; production must set a secret value.
API_KEY=<SET_IN_DEPLOYMENT_SECRET_STORE>

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
RAG_RETRIEVAL_K=5
TEMPERATURE=0.2
MAX_TOKENS=1024

# FAISS security: required when loading the persisted local index.
# This must match config/faiss_index.pkl.sha256, which is verified during the image build.
FAISS_INDEX_PKL_SHA256=590424fb3526de38d2d5ae836f930adc747a981567d4e4b7df80694967f7ae5f

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Streamlit deployment: configure these same keys in Streamlit Secrets.
# Never commit production credentials or password hashes.
# APP_ENVIRONMENT=production
# AUTH_USERNAME=analyst
# AUTH_PASSWORD_HASH=<same PBKDF2 hash configured in Render>
# AUTH_ROLE=analyst
# LLM_PROVIDER=groq
# LLM_MODEL=<production-model>
# API_BASE_URL=https://api.groq.com/openai/v1
# API_KEY=<deployment secret>
# FAISS_INDEX_PKL_SHA256=590424fb3526de38d2d5ae836f930adc747a981567d4e4b7df80694967f7ae5f
