# Copy to .env and change values as needed.
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

# Application authentication (required for public-facing deployment).
# Generate a PBKDF2-SHA256 hash with scripts/generate_auth_hash.py and store
# the resulting value as AUTH_PASSWORD_HASH in the deployment secret store.
AUTH_USERNAME=analyst
AUTH_PASSWORD_HASH=pbkdf2_sha256$600000$c65e836b85642ea86937e2912443ba4e$43d4c06275ddbb9ecdecf4417bf24a66a1a1f0a1c6e1db032eb98b0451cfaf06
AUTH_ROLE=analyst
AUTH_SESSION_TTL_SECONDS=3600
AUTH_PBKDF2_ITERATIONS=600000

# Local Ollama via its OpenAI-compatible API.
LLM_PROVIDER=ollama
LLM_MODEL=llama2
OLLAMA_MODEL=llama2
OLLAMA_API_BASE=http://localhost:11434/v1
API_BASE_URL=http://localhost:11434/v1
# Ollama does not require a real API key; the OpenAI client needs a value.
API_KEY=ollama

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG
RAG_RETRIEVAL_K=5
TEMPERATURE=0.2
MAX_TOKENS=1024

# FAISS security: required when loading a persisted local index.
# Set this to the trusted SHA-256 of vectorstore/faiss_index/index.pkl.
FAISS_INDEX_PKL_SHA256=

# Streamlit
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS=0.0.0.0
