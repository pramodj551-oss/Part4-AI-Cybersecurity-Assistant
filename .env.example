# =============================================================================
# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# =============================================================================

# --------------------------------------------------
# Application Configuration
# --------------------------------------------------

APP_TITLE="🛡️ AI Cybersecurity Assistant"
APP_ICON="🛡️"
APP_VERSION="4.0"
APP_ENVIRONMENT=development  # development | staging | production
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --------------------------------------------------
# Streamlit Configuration
# --------------------------------------------------

STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=1024
STREAMLIT_LOGGER_LEVEL=info
STREAMLIT_CLIENT_THEME=dark  # light | dark

# --------------------------------------------------
# Data Pipeline (Part 1)
# --------------------------------------------------

DATA_PIPELINE_URL=http://part1-data-pipeline:8000
DATA_PATH=/data
DATA_OUTPUT_FORMAT=csv  # csv | json | parquet
DATA_RETENTION_DAYS=90

# Database configuration
DATABASE_PATH=/data/security.db
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL_HOURS=24

# --------------------------------------------------
# ML Pipeline (Part 2)
# --------------------------------------------------

ML_PIPELINE_URL=http://part2-ml-pipeline:8001
MODEL_PATH=/models
MODEL_NAME=trained_model.pkl
MODEL_VERSION=1.0

# Feature scaling
FEATURE_SCALER_PATH=/models/feature_scaler.pkl
FEATURE_NAMES_PATH=/models/feature_names.json

# Model predictions
PREDICTIONS_DATA_PATH=/data/predictions.csv
PREDICTION_CONFIDENCE_THRESHOLD=0.5

# GPU Configuration (if available)
CUDA_VISIBLE_DEVICES=0  # Set to empty string "" to disable GPU
USE_GPU=false  # true | false

# --------------------------------------------------
# Vector Store Configuration (FAISS)
# --------------------------------------------------

VECTORSTORE_PATH=/vectorstore
VECTORSTORE_TYPE=faiss  # faiss | milvus | weaviate
VECTORSTORE_DIMENSION=384  # Embedding dimension
FAISS_INDEX_TYPE=IVF  # IVF | FLAT | IVFPQ

# Vector database backend
VECTORDB_BACKEND=in_memory  # in_memory | persistent | cloud

# Index settings
FAISS_NLIST=100  # Number of centroids for IVF
FAISS_NPROBE=10  # Number of probes for search
FAISS_USE_GPU=false

# --------------------------------------------------
# Embedding Configuration
# --------------------------------------------------

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu  # cpu | cuda | mps

# Cache embeddings
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_PATH=/root/.cache/embeddings

# --------------------------------------------------
# LLM Configuration (Ollama)
# --------------------------------------------------

OLLAMA_API_BASE=http://ollama:11434
OLLAMA_MODEL=llama2  # Available: llama2, mistral, neural-chat, etc.
OLLAMA_TEMPERATURE=0.7  # 0.0 - 1.0 (higher = more creative)
OLLAMA_TOP_P=0.9  # 0.0 - 1.0
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1

# LLM timeout and retries
OLLAMA_REQUEST_TIMEOUT=300  # seconds
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=5  # seconds

# Token limits
OLLAMA_MAX_TOKENS=2048
OLLAMA_CONTEXT_LENGTH=4096

# --------------------------------------------------
# RAG Pipeline Configuration
# --------------------------------------------------

RAG_RETRIEVAL_K=5  # Number of documents to retrieve
RAG_RETRIEVAL_SCORE_THRESHOLD=0.5
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=sentence-transformers/cross-encoder-ms-marco-MiniLM-L-6-v2

# RAG Cache
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600  # seconds (1 hour)

# --------------------------------------------------
# Document Processing
# --------------------------------------------------

PDF_EXTRACTION_ENABLED=true
TEXT_CHUNK_SIZE=512  # characters
TEXT_CHUNK_OVERLAP=50  # characters
MAX_DOCUMENT_PAGES=100

# Supported formats
SUPPORTED_FORMATS=pdf,txt,md,csv,json

# --------------------------------------------------
# Knowledge Base
# --------------------------------------------------

KNOWLEDGE_BASE_PATH=/data/knowledge_base
KNOWLEDGE_BASE_AUTO_REFRESH=true
KNOWLEDGE_BASE_REFRESH_INTERVAL_HOURS=24

# SOP Configuration
SOP_PATH=/data/sop_documents
SOP_AUTO_INDEX=true

# FAQ Configuration
FAQ_PATH=/data/faq.csv
FAQ_AUTO_INDEX=true

# --------------------------------------------------
# Search Configuration
# --------------------------------------------------

SEARCH_HYBRID_ENABLED=false  # Hybrid keyword + vector search
SEARCH_KEYWORD_WEIGHT=0.3
SEARCH_VECTOR_WEIGHT=0.7
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT=30  # seconds

# --------------------------------------------------
# Chat Configuration
# --------------------------------------------------

CHAT_HISTORY_ENABLED=true
CHAT_HISTORY_PATH=/data/chat_history
CHAT_MAX_HISTORY_ITEMS=100
CHAT_SESSION_TIMEOUT_MINUTES=60

# --------------------------------------------------
# Database Configuration
# --------------------------------------------------

# PostgreSQL
POSTGRES_USER=cybersec_user
POSTGRES_PASSWORD=cybersec_password
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=cybersecurity_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_CACHE_TTL=3600  # seconds

# --------------------------------------------------
# Monitoring & Logging
# --------------------------------------------------

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PATH=/metrics

# Grafana
GRAFANA_ENABLED=true
GRAFANA_URL=http://grafana:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Logging
LOG_FILE_PATH=/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10
LOG_FORMAT=json  # json | text

# Sentry (Error Tracking) - Optional
SENTRY_DSN=

# --------------------------------------------------
# Security Configuration
# --------------------------------------------------

# API Keys
OPENAI_API_KEY=  # Optional: for OpenAI API fallback
HUGGINGFACE_API_KEY=  # Optional: for HuggingFace model access

# Secret key for sessions
SECRET_KEY=your-secret-key-here-change-in-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8502,http://localhost:8501
CORS_ALLOW_CREDENTIALS=true

# Authentication (if implementing)
AUTH_ENABLED=false
AUTH_METHOD=oauth  # oauth | jwt | basic
AUTH_PROVIDER=github  # github | google | microsoft

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# --------------------------------------------------
# File Paths & Storage
# --------------------------------------------------

# Base paths
BASE_DATA_PATH=/data
BASE_MODEL_PATH=/models
BASE_LOG_PATH=/logs

# Temporary files
TEMP_PATH=/tmp/cybersecurity
UPLOAD_PATH=/data/uploads
MAX_UPLOAD_SIZE_MB=100

# --------------------------------------------------
# Sync Configuration
# --------------------------------------------------

# Repository sync settings
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=24
SYNC_ON_STARTUP=true

# Part 1 Data Pipeline
PART1_REPO_PATH=../Part1-Cybersecurity-Data-Pipeline
PART1_AUTO_FETCH=true

# Part 2 ML Pipeline
PART2_REPO_PATH=../Part2-Cybersecurity-ML-Pipeline
PART2_AUTO_FETCH=true

# Part 3 Dashboard
PART3_REPO_PATH=../Part3-Cybersecurity-Dashboard
PART3_AUTO_FETCH=true

# --------------------------------------------------
# Feature Flags
# --------------------------------------------------

FEATURE_RAG_ENABLED=true
FEATURE_INCIDENT_SEARCH_ENABLED=true
FEATURE_SOP_RETRIEVAL_ENABLED=true
FEATURE_CHAT_ENABLED=true
FEATURE_KNOWLEDGE_BASE_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_EXPORT_ENABLED=true

# --------------------------------------------------
# Development Configuration
# --------------------------------------------------

DEBUG_MODE=false
DEBUG_LOGGING=false
DEV_AUTO_RELOAD=true
DEV_RELOAD_DELAY=2  # seconds

# --------------------------------------------------
# Performance Tuning
# --------------------------------------------------

# Threading
WORKER_THREADS=4
MAX_QUEUE_SIZE=1000

# Caching
CACHE_ENABLED=true
CACHE_BACKEND=redis  # redis | memory | disk

# Batch Processing
BATCH_SIZE=32
BATCH_TIMEOUT_SECONDS=30

# --------------------------------------------------
# Deployment Configuration
# --------------------------------------------------

# Environment
DEPLOYMENT_ENV=docker  # docker | kubernetes | cloud

# Auto-scaling
AUTO_SCALE_ENABLED=false
MIN_REPLICAS=1
MAX_REPLICAS=3

# Health checks
HEALTH_CHECK_INTERVAL=30  # seconds
HEALTH_CHECK_TIMEOUT=10  # seconds

# --------------------------------------------------
# Notification & Alerts (Optional)
# --------------------------------------------------

ALERTS_ENABLED=false
ALERT_EMAIL=admin@example.com
ALERT_SLACK_WEBHOOK=
ALERT_DISCORD_WEBHOOK=

# --------------------------------------------------
# External Services (Optional)
# --------------------------------------------------

# GitHub
GITHUB_TOKEN=
GITHUB_REPO_OWNER=pramodj551-oss
GITHUB_REPO_NAME=Part4-AI-Cybersecurity-Assistant

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Webhooks
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=30
